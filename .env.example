# Переменные окружения ВКР-чекера. Скопируйте файл в .env и заполните значения.
# .env в git не попадает. Реальные значения хранятся в менеджере паролей
# и на сервере в /opt/vkr-checker/.env. Где взять каждый ключ, см. docs/SERVICES.md.

# --- Языковая модель (обязательно) -------------------------------------------
# Прод: Qwen 3.6 35B через Yandex AI Studio (OpenAI-совместимый API).
# API-ключ сервисного аккаунта Yandex Cloud, область yc.ai.languageModels.execute.
# При создании ключа в консоли уберите срок действия (по умолчанию 90 дней).
OPENAI_API_KEY=
# https://llm.api.cloud.yandex.net/v1 для Yandex AI Studio; пусто = api.openai.com
OPENAI_BASE_URL=
# Прод: gpt://<folder-id>/qwen3.6-35b-a3b/latest; пусто = gpt-4o-mini
OPENAI_MODEL=

# --- Вход преподавателей (необязательно) ---------------------------------------
# Секрет подписи сессионной куки. Если пусто, сервис сам сгенерирует его при
# первом запуске и сохранит в базе (settings.session_secret).
SESSION_SECRET=

# --- Email-дайджест преподавателю (необязательно) ------------------------------
# Без SMTP_HOST и SMTP_USER дайджест не отправляется, а показывается как превью.
# Адрес получателя задаётся в панели преподавателя (settings.digest_email), не здесь.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Дашборд мониторинга проектов (необязательно) ------------------------------
# Без них телеметрия отключена. Токен выпускается на странице «Проекты» дашборда.
DASHBOARD_URL=
DASHBOARD_TOKEN=

# PORT=3000 и HOSTNAME=0.0.0.0 задаются в docker-compose.yml,
# NODE_OPTIONS (лимит памяти Node) задаётся в Dockerfile.
# DIGEST_RECIPIENT код не читает: на проде строка осталась от старой версии.
